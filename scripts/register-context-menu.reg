@="Ask Local Pilot"
"Icon"="C:\\Users\\adrian.patrick\\OneDrive - InTimeTec Visionsoft Pvt. Ltd.,\\Desktop\\coding\\local-pilot\\src-tauri\\target\\release\\Local Pilot.exe"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\AskLocalPilot\command]
