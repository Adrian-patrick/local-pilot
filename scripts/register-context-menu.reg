Windows Registry Editor Version 5.00

; ============================================================================
; Local Pilot Context Menu Registration Template (.reg)
; ============================================================================
; INSTRUCTIONS:
; 1. Replace the executable paths below with the actual absolute path to your built
;    "Local Pilot.exe" file.
; 2. Note: Use double backslashes (\\) in the path.
; 3. Save this file and double-click it to apply changes to your registry.
; ============================================================================

; --- For all files ---
[HKEY_CURRENT_USER\Software\Classes\*\shell\AskLocalPilot]
@="Ask Local Pilot"
"Icon"="C:\\Users\\adrian.patrick\\OneDrive - InTimeTec Visionsoft Pvt. Ltd.,\\Desktop\\coding\\local-pilot\\src-tauri\\target\\release\\Local Pilot.exe"

[HKEY_CURRENT_USER\Software\Classes\*\shell\AskLocalPilot\command]
@="\"C:\\Users\\adrian.patrick\\OneDrive - InTimeTec Visionsoft Pvt. Ltd.,\\Desktop\\coding\\local-pilot\\src-tauri\\target\\release\\Local Pilot.exe\" \"%1\""

; --- For folders/directories ---
